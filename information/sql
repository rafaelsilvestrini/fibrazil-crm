CREATE TABLE enterprise (
    id INT AUTO_INCREMENT PRIMARY KEY,
    company_name VARCHAR(255),
    nif VARCHAR(20),
    email VARCHAR(255),
    street_address VARCHAR(255),
    city VARCHAR(100),
    postal_code VARCHAR(20),
    country VARCHAR(100),
    phone_number VARCHAR(20)
);
